# syntax=docker/dockerfile:1.7
#
# Base image must ship git >= 2.41: jj (jujutsu) refuses to run its git backend
# on older versions, so `jj git fetch` / `jj git push` fail for every consumer.
# node:20 is bookworm-based (git 2.39.5) and broke exactly this — keep the
# trixie tag, which matches what the nexus root ran before the kernel cutover.
FROM node:22-trixie AS kernel-base

ARG TZ
ENV TZ="$TZ"

ARG CLAUDE_CODE_VERSION=latest

# Install basic development tools and iptables/ipset
RUN apt-get update && apt-get install -y --no-install-recommends \
  less \
  git \
  procps \
  sudo \
  fzf \
  zsh \
  man-db \
  unzip \
  gnupg2 \
  gh \
  iptables \
  ipset \
  iproute2 \
  dnsutils \
  aggregate \
  jq \
  nano \
  vim \
  cron \
  git-lfs \
  tmux \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Docker CLI + Compose plugin (for Docker-outside-of-Docker via socket mount)
RUN install -m 0755 -d /etc/apt/keyrings && \
  curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc && \
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list && \
  apt-get update && apt-get install -y --no-install-recommends \
  docker-ce-cli \
  docker-compose-plugin \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Ensure default node user has access to /usr/local/share
RUN mkdir -p /usr/local/share/npm-global && \
  chown -R node:node /usr/local/share

ARG USERNAME=node

# Add node to docker group for socket access (GID must match host socket owner)
ARG DOCKER_GID=989
RUN (getent group docker > /dev/null && groupmod -g $DOCKER_GID docker || groupadd -g $DOCKER_GID docker) \
  && usermod -aG docker $USERNAME

# Persist bash history
RUN SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  && mkdir /commandhistory \
  && touch /commandhistory/.bash_history \
  && chown -R $USERNAME /commandhistory

ENV DEVCONTAINER=true

# Create workspace and config directories
RUN mkdir -p /workspace /in /out /home/node/.claude && \
  chown -R node:node /workspace /in /out /home/node/.claude

WORKDIR /workspace

ARG GIT_DELTA_VERSION=0.18.2
RUN ARCH=$(dpkg --print-architecture) && \
  wget "https://github.com/dandavison/delta/releases/download/${GIT_DELTA_VERSION}/git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
  sudo dpkg -i "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
  rm "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb"

# mise (runtime manager)
ENV MISE_DATA_DIR=/opt/mise \
    MISE_CONFIG_DIR=/etc/mise \
    MISE_CACHE_DIR=/opt/mise/cache \
    MISE_TRUSTED_CONFIG_PATHS=/workspace/.mise.toml

RUN curl https://mise.run | sh && \
    cp /root/.local/bin/mise /usr/local/bin/mise && \
    mkdir -p /opt/mise /etc/mise /opt/mise/cache && \
    mise use -g node@22 && \
    mise use -g python@3.12 && \
    mise use -g uv@latest && \
    mise reshim && \
    chown -R node:node /opt/mise /etc/mise

ENV PATH="/opt/mise/shims:${PATH}"

USER node

ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$PATH:/usr/local/share/npm-global/bin
ENV SHELL=/bin/zsh
ENV EDITOR=nano
ENV VISUAL=nano

ARG ZSH_IN_DOCKER_VERSION=1.2.0
RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v${ZSH_IN_DOCKER_VERSION}/zsh-in-docker.sh)" -- \
  -p git \
  -p fzf \
  -a "source /usr/share/doc/fzf/examples/key-bindings.zsh" \
  -a "source /usr/share/doc/fzf/examples/completion.zsh" \
  -a "export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  -a 'eval "$(mise activate zsh)"' \
  -x

RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# Copy firewall script and universal allowlists. Both _required/ (hard-fail on
# DNS miss) and _optional/ (warn-and-skip) are always loaded at boot.
COPY .devcontainer/init-firewall.sh /usr/local/bin/
COPY .devcontainer/firewall.d/_required/ /usr/local/bin/firewall.d/_required/
COPY .devcontainer/firewall.d/_optional/ /usr/local/bin/firewall.d/_optional/

USER root
RUN chmod +x /usr/local/bin/init-firewall.sh && \
  echo "node ALL=(root) NOPASSWD: SETENV: /usr/local/bin/init-firewall.sh" > /etc/sudoers.d/node-firewall && \
  chmod 0440 /etc/sudoers.d/node-firewall
USER node


# =============================================================================
# Beads builder — THROWAWAY. Compiles the `bd` CLI from the pinned fork. The Go
# toolchain never reaches a shipped layer; only the binary is COPYed out.
#
# The fork publishes no releases or tags, so the pin is a full commit SHA
# (.devcontainer/beads/_.jsonld), fetched shallow like the hermes-agent pin.
#
# `make build` is the canonical target: CGO_ENABLED=1 (embedded Dolt needs cgo)
# with -tags=gms_pure_go. The tag swaps go-mysql-server's ICU-backed regex for
# Go's stdlib regexp, so the binary carries NO libicu dependency — the fork
# treats that as non-negotiable policy (engdocs/ICU-POLICY.md), which is why
# neither this stage nor beads-base installs ICU. A bare `go build` without the
# tag would fail on a missing unicode/uregex.h instead.
#
# The builder base must stay on the same Debian release as kernel-base: cgo
# links bd against the builder's glibc, and a trixie->bookworm mismatch would
# only surface at container start.
# =============================================================================
FROM golang:1.26-trixie AS beads-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    make \
    jq \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY .devcontainer/beads/_.jsonld /tmp/beads.jsonld
RUN BEADS_CLONE_URL=$(jq -r '."nexus:cloneURL"' /tmp/beads.jsonld) && \
    BEADS_REF=$(jq -r '."nexus:pinnedRef"' /tmp/beads.jsonld) && \
    { [ -n "$BEADS_CLONE_URL" ] && [ "$BEADS_CLONE_URL" != "null" ] && \
      [ -n "$BEADS_REF" ] && [ "$BEADS_REF" != "null" ]; } \
      || (echo "ERROR: beads pin missing cloneURL/pinnedRef" && exit 1) && \
    mkdir -p /out && \
    git init -q /usr/src/beads && \
    cd /usr/src/beads && \
    git remote add origin "$BEADS_CLONE_URL" && \
    git fetch --depth 1 origin "$BEADS_REF" && \
    git checkout -q FETCH_HEAD && \
    make build && \
    install -m 0755 /usr/src/beads/bd /out/bd


# =============================================================================
# Beads substrate — the `bd` CLI plus the Dolt engine it stores the task graph
# in. Every agent image re-parents onto this layer, so an agent container in any
# consumer org can talk to the org's shared beads graph by construction.
#
# kernel-base itself deliberately stays lean: non-agent consumers that only want
# the dev environment don't pay for ~140 MB of task-graph substrate.
# =============================================================================
FROM kernel-base AS beads-base

USER root

# flock: beads takes advisory locks around Dolt maintenance operations. Present
# in node:22-trixie via util-linux already; named here so the contract survives
# a base-image change.
RUN apt-get update && apt-get install -y --no-install-recommends \
    util-linux \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Dolt from the pinned upstream release tarball (a static Go binary — no runtime
# library deps). Version floor is >= 2.1.0; see the pin file for why.
#
# The tarball is verified against a per-arch sha256 in the pin file. bd gets a
# full-commit-SHA pin for supply-chain integrity; a version+URL fetch alone
# would not match that bar, since a re-pushed tag or a swapped release asset
# installs silently. Bumping the dolt version means updating both the version
# and the digests.
COPY .devcontainer/beads/_.jsonld /tmp/beads.jsonld
RUN jq -e '."nexus:requires"[] | select(."dcterms:title"=="dolt")' /tmp/beads.jsonld \
      > /tmp/dolt.jsonld && \
    ARCH=$(dpkg --print-architecture) && \
    DOLT_VERSION=$(jq -r '."dcterms:hasVersion"' /tmp/dolt.jsonld) && \
    DOLT_ARCH=$(jq -r --arg a "$ARCH" '."nexus:archMap"[$a]' /tmp/dolt.jsonld) && \
    DOLT_URL=$(jq -r --arg v "$DOLT_VERSION" --arg a "$DOLT_ARCH" \
      '."nexus:downloadURLTemplate" | gsub("\\{version\\}"; $v) | gsub("\\{arch\\}"; $a)' \
      /tmp/dolt.jsonld) && \
    DOLT_SHA256=$(jq -r --arg a "$ARCH" '."nexus:sha256"[$a]' /tmp/dolt.jsonld) && \
    { [ -n "$DOLT_VERSION" ] && [ "$DOLT_VERSION" != "null" ]; } \
      || (echo "ERROR: beads pin missing dolt version" && exit 1) && \
    [ "$DOLT_ARCH" != "null" ] || (echo "Unsupported arch for dolt: $ARCH" && exit 1) && \
    { [ -n "$DOLT_SHA256" ] && [ "$DOLT_SHA256" != "null" ]; } \
      || (echo "ERROR: beads pin missing dolt sha256 for arch $ARCH" && exit 1) && \
    wget -O /tmp/dolt.tar.gz "$DOLT_URL" && \
    echo "${DOLT_SHA256}  /tmp/dolt.tar.gz" | sha256sum -c - && \
    mkdir -p /tmp/dolt-extract && \
    tar --no-same-owner -xzf /tmp/dolt.tar.gz -C /tmp/dolt-extract && \
    install -m 0755 /tmp/dolt-extract/dolt-linux-*/bin/dolt /usr/local/bin/dolt && \
    rm -rf /tmp/dolt.tar.gz /tmp/dolt-extract /tmp/dolt.jsonld /tmp/beads.jsonld

COPY --from=beads-build /out/bd /usr/local/bin/bd

# Fail the build here rather than at a consumer's first `bd` invocation.
RUN command -v bd && command -v dolt && command -v flock && \
    bd version && dolt version

USER node


# =============================================================================
# Beads server — the shared task graph itself: a `dolt sql-server` over a data
# directory that consumers mount as a named volume. This is the multi-writer
# path; embedded mode (bd's default) is single-writer and cannot back more than
# one container. Clients reach it by compose DNS, no host port published.
# =============================================================================
FROM beads-base AS beads-server

USER root
COPY .devcontainer/entrypoint-beads.sh /usr/local/bin/
# Create the data dir in the IMAGE so docker seeds a named volume mounted here
# with node ownership; a volume over a missing path lands root-owned and the
# server can't write it.
RUN chmod +x /usr/local/bin/entrypoint-beads.sh && \
    mkdir -p /beads && chown node:node /beads
USER node

ENV BEADS_DATA_DIR=/beads \
    BEADS_PORT=3307
EXPOSE 3307
CMD ["/usr/local/bin/entrypoint-beads.sh"]


# =============================================================================
# Hermes Agent Dependencies — adds the hermes-agent Python venv on top of
# beads-base (which is kernel-base + the bd/dolt substrate, so hermes agents
# carry the beads client). Slim extras set (no playwright / no voice / no heavy
# cloud SDKs); add extras via the pin file's nexus:pipExtras if an agent needs
# them.
# =============================================================================
FROM beads-base AS hermes-deps

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    gosu \
    build-essential \
    python3-dev \
    libffi-dev \
    ripgrep \
  && apt-get clean && rm -rf /var/lib/apt/lists/*
USER node

ENV PYTHONUNBUFFERED=1 \
    COPILOT_CLI_PREFIX=/usr/local/share/npm-global

# Install the hermes-agent harness into a dedicated venv. Unlike the nexus root
# (which COPYs from its aliens/hermes-agent submodule), the kernel clones the
# public repo at a pinned commit driven by .devcontainer/hermes-agent/_.jsonld
# — the same version-pin pattern used for jj and flyctl at the root. This keeps
# the image buildable from the kernel directory alone, with no aliens/ submodule
# in the build context. The clone is shallow at the pinned SHA (a branch tip on
# the public repo) and installed editable to preserve the PYTHONPATH semantics
# the root relies on.
COPY --chown=node:node .devcontainer/hermes-agent/_.jsonld /tmp/hermes-agent.jsonld
COPY --chown=node:node .devcontainer/hermes-venv-requirements.txt /tmp/hermes-venv-requirements.txt
RUN HERMES_CLONE_URL=$(jq -r '."nexus:cloneURL"' /tmp/hermes-agent.jsonld) && \
    HERMES_REF=$(jq -r '."nexus:pinnedRef"' /tmp/hermes-agent.jsonld) && \
    HERMES_EXTRAS=$(jq -r '."nexus:pipExtras"' /tmp/hermes-agent.jsonld) && \
    HERMES_DIR=$(jq -r '."nexus:installPrefix"' /tmp/hermes-agent.jsonld) && \
    { [ -n "$HERMES_CLONE_URL" ] && [ "$HERMES_CLONE_URL" != "null" ] && \
      [ -n "$HERMES_REF" ] && [ "$HERMES_REF" != "null" ] && \
      [ -n "$HERMES_DIR" ] && [ "$HERMES_DIR" != "null" ]; } \
      || (echo "ERROR: hermes-agent pin missing cloneURL/pinnedRef/installPrefix" && exit 1) && \
    git init -q "$HERMES_DIR" && \
    cd "$HERMES_DIR" && \
    git remote add origin "$HERMES_CLONE_URL" && \
    git fetch --depth 1 origin "$HERMES_REF" && \
    git checkout -q FETCH_HEAD && \
    mise exec -- uv venv venv --python 3.12 && \
    VIRTUAL_ENV="$HERMES_DIR/venv" mise exec -- uv pip install --no-cache-dir \
      -e ".${HERMES_EXTRAS}" && \
    VIRTUAL_ENV="$HERMES_DIR/venv" mise exec -- uv pip install --no-cache-dir \
      -r /tmp/hermes-venv-requirements.txt && \
    mkdir -p /home/node/.local/bin && \
    ln -sf "$HERMES_DIR/venv/bin/hermes" /home/node/.local/bin/hermes && \
    rm -f /tmp/hermes-agent.jsonld /tmp/hermes-venv-requirements.txt

ENV PATH="/home/node/.local/bin:${PATH}" \
    PYTHONPATH="/home/node/hermes-agent"


# =============================================================================
# Hermes Agent — thin config layer on top of hermes-deps.
# Only entrypoint, scripts, and default config files live here so that
# changes to these files rebuild in seconds.
# =============================================================================
FROM hermes-deps AS hermes

USER root
RUN mkdir -p /home/node/.hermes/{cron,sessions,logs,memories,skills,hooks,skins,plans,workspace,home} \
    && mkdir -p /home/node/.copilot \
    && chown -R node:node /home/node/.hermes /home/node/.copilot

COPY .devcontainer/entrypoint-hermes.sh /usr/local/bin/
COPY .devcontainer/hermes-entrypoint/ /usr/local/share/hermes-entrypoint/
COPY .devcontainer/hermes-config.yaml /usr/local/share/hermes-defaults/config.yaml.default
COPY .devcontainer/hermes-soul.default.md /usr/local/share/hermes-defaults/SOUL.md.default

RUN chmod +x /usr/local/bin/entrypoint-hermes.sh && \
    find /usr/local/share/hermes-entrypoint -type d -exec chmod 0755 {} + && \
    find /usr/local/share/hermes-entrypoint -type f -exec chmod 0644 {} + && \
    chown -R root:root /usr/local/share/hermes-entrypoint && \
    chown -R node:node /usr/local/share/hermes-defaults

ENV HERMES_HOME=/home/node/.hermes \
    HERMES_WORKSPACE_PATH=/workspace \
    DEFAULT_WORKSPACE_ROOT=/workspace
# Entrypoint starts as root for state-link bootstrap, then drops to node via gosu.


# =============================================================================
# Gas City builder — THROWAWAY. Compiles the `gc` CLI from the pinned fork. The
# Go toolchain never reaches a shipped layer; only the binary is COPYed out.
#
# The fork publishes no releases or tags, so the pin is a full commit SHA
# (.devcontainer/gascity/_.jsonld), fetched shallow like the beads pin.
#
# CGO_ENABLED=0 `make build` is the fork's own release configuration — its
# .goreleaser.yml builds every published binary with CGO_ENABLED=0, and the
# install docs describe the result as "a single static file". The upstream
# libicu-dev prerequisite applies only to CGO-enabled builds (every ICU block
# in the fork's Makefile is CGO plumbing), so with CGO off the binary is fully
# static and neither this stage nor the runtime stage installs ICU — verified
# with ldd ("not a dynamic executable"). This also means no glibc coupling
# between builder and runtime, unlike the cgo-built bd.
# =============================================================================
FROM golang:1.26-trixie AS gascity-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    make \
    jq \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY .devcontainer/gascity/_.jsonld /tmp/gascity.jsonld
RUN GASCITY_CLONE_URL=$(jq -r '."nexus:cloneURL"' /tmp/gascity.jsonld) && \
    GASCITY_REF=$(jq -r '."nexus:pinnedRef"' /tmp/gascity.jsonld) && \
    { [ -n "$GASCITY_CLONE_URL" ] && [ "$GASCITY_CLONE_URL" != "null" ] && \
      [ -n "$GASCITY_REF" ] && [ "$GASCITY_REF" != "null" ]; } \
      || (echo "ERROR: gascity pin missing cloneURL/pinnedRef" && exit 1) && \
    mkdir -p /out && \
    git init -q /usr/src/gascity && \
    cd /usr/src/gascity && \
    git remote add origin "$GASCITY_CLONE_URL" && \
    git fetch --depth 1 origin "$GASCITY_REF" && \
    git checkout -q FETCH_HEAD && \
    CGO_ENABLED=0 make build && \
    install -m 0755 /usr/src/gascity/bin/gc /out/gc


# =============================================================================
# Gas City — the bead-native multi-agent orchestrator, running a city against
# the org's shared beads graph. Builds on beads-base, so bd + dolt + flock
# arrive from the layer; the claude CLI (an agent runtime provider gc invokes)
# comes from kernel-base underneath it. No Go toolchain ships here.
# =============================================================================
FROM beads-base AS gascity

USER root

# gc's documented runtime prerequisites are tmux, jq, git, dolt, bd, and flock.
# tmux/jq/git are in kernel-base and dolt/bd/flock in beads-base already, but
# the full set is named here (plus procps/lsof, which gc's session and process
# management shells out to) so the contract survives a base-image change.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    jq \
    procps \
    lsof \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=gascity-build /out/gc /usr/local/bin/gc
COPY .devcontainer/entrypoint-gascity.sh /usr/local/bin/

# Create the city dir in the IMAGE so docker seeds a named volume mounted here
# with node ownership; a volume over a missing path lands root-owned and gc
# can't write it.
RUN chmod +x /usr/local/bin/entrypoint-gascity.sh && \
    mkdir -p /city && chown node:node /city

USER node

# oh-my-zsh's git plugin (baked into kernel-base's zsh setup) aliases gc to
# `git commit --verbose`, shadowing the Gas City binary in every interactive
# shell — upstream's docs call this out and recommend exactly this custom-dir
# unalias, which oh-my-zsh sources after its plugins load.
RUN mkdir -p /home/node/.oh-my-zsh/custom && \
    printf 'unalias gc 2>/dev/null || true\n' > /home/node/.oh-my-zsh/custom/gascity.zsh

# Fail the build here rather than at a consumer's first `gc` invocation.
RUN command -v gc && command -v tmux && command -v jq && \
    command -v bd && command -v dolt && command -v flock && \
    gc version

ENV GC_CITY_DIR=/city
CMD ["/usr/local/bin/entrypoint-gascity.sh"]