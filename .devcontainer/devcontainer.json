{
  "name": "nexus-kernel",
  "dockerComposeFile": ["compose.base.yml"],
  "service": "nexus-kernel-base",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "ms-toolsai.jupyter",
        "ms-python.python",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "zsh" },
          "bash": { "path": "bash", "icon": "terminal-bash" }
        }
      }
    }
  },
  "postCreateCommand": "git config --global include.path /workspace/.devcontainer/gitconfig.base",
  "postStartCommand": "sudo -E /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}