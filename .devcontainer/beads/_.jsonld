{
  "@context": ["inner//core/nexus.jsonld", {"@base": "inner//.devcontainer/beads/"}],
  "@id": "inner:.devcontainer/beads",
  "@type": ["dcat:Dataset"],
  "dcterms:title": "beads",
  "dcterms:source": {"@id": "https://github.com/LatentLabsSpace/beads"},
  "dcterms:description": "Beads — the Dolt-backed distributed task graph the kernel ships as its shared work substrate. The `bd` CLI is built from source in the throwaway `beads-build` stage and copied into `beads-base`, which every agent image (hermes, and later gascity) re-parents onto. The pin is a full commit SHA on the fork patch branch `nexus/main` (fork `main` stays a pure upstream mirror; upstream's `v*` release tags are mirrored into the fork, but the fork cuts no releases of its own). Since 2026-10-03 (https://github.com/LatentLabsSpace/beads/pull/4) `nexus/main` follows upstream's RELEASE line, not upstream `main`: it is upstream v1.3.1 (schema migration 66 — gascity v1.5.0-rc1's beads) plus the carried delta. Carried patches: (1) the remaining server-mode lost-update write surface — every in-transaction DOLT_ADD/DOLT_COMMIT in internal/storage/dolt migrated to post-transaction ordering (original fix https://github.com/LatentLabsSpace/beads/pull/2, re-ported onto v1.3.1 in https://github.com/LatentLabsSpace/beads/pull/4); upstream fixed the main mutation path itself in v1.3.0 (gastownhall/beads#6040, the carried #5740), so the fork's old patch #1 is dropped; (2) the fork-permanent Claude Code Review CI workflow plus `nexus/**` pull_request triggers on pr.yml/regression.yml. Caller-visible contract: a failed post-transaction Dolt commit is logged + counted (postTxCommitDropped) and no longer returns ErrCommitIndeterminate. go.mod requires toolchain go1.26.7; the golang:1.26-trixie builder must resolve to >= that (verified go1.26.8 at pin time) or the build tries to download a toolchain through the firewall. Build is CGO_ENABLED=1 (embedded Dolt needs cgo) with -tags=gms_pure_go, which is what `make build` does; the tag drops the ICU shared-library dependency, so neither the builder nor the runtime layer needs libicu (see the fork's engdocs/ICU-POLICY.md).",
  "nexus:installVia": "source-build",
  "nexus:cloneURL": "https://github.com/LatentLabsSpace/beads.git",
  "nexus:pinnedRef": "1d311ecc459b6ae55df19ae29c95a7f933d8d300",
  "nexus:pinnedBranch": "nexus/main",
  "nexus:buildCommand": "make build",
  "nexus:buildImage": "golang:1.26-trixie",
  "nexus:binaryName": "bd",
  "nexus:installPrefix": "/usr/local/bin",
  "nexus:requires": [
    {
      "@id": "inner:.devcontainer/beads#dolt",
      "@type": ["dcat:Dataset"],
      "dcterms:title": "dolt",
      "dcterms:source": {"@id": "https://github.com/dolthub/dolt"},
      "dcterms:description": "Dolt — the versioned SQL database under Beads. Installed from the upstream release tarball; `dolt sql-server` is what the kernel's `beads-server` target runs, and bd clients in server mode connect to it over the compose network. Floor is >= 2.1.0: the beads fork's docs flag that pre-1.86.2 builds miss the GC/writer deadlock fix (dolthub/dolt ccf7bde206). 2.2.x also matches the dolthub/driver/v2 v2.2.0 the pinned bd depends on.",
      "dcterms:license": {"@id": "https://spdx.org/licenses/Apache-2.0"},
      "dcterms:hasVersion": "2.2.3",
      "nexus:installVia": "binary-tarball",
      "nexus:downloadURLTemplate": "https://github.com/dolthub/dolt/releases/download/v{version}/dolt-linux-{arch}.tar.gz",
      "nexus:archMap": {
        "amd64": "amd64",
        "arm64": "arm64"
      },
      "nexus:sha256": {
        "amd64": "ffafa7cc172cada5f77ca3fb96306545ddac44a111625f75f870306c7f197301",
        "arm64": "5e8f4dbe61931c36f8359022ee32337e5daf65aba06a29791a066e50677c8b3a"
      },
      "nexus:binaryName": "dolt",
      "nexus:installPrefix": "/usr/local/bin"
    }
  ]
}
