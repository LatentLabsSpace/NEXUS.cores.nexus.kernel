# Per-agent env file for {{AGENT_NAME}}.
# Copy to ./quarters/crew/{{AGENT_NAME}}/.env (same directory), fill in
# values, then run:  docker compose up -d {{AGENT_NAME}}
#
# .env is gitignored; this template is checked in. Never paste real
# credentials into chat — edit the .env file directly.
#
# ─── Credential remapping (service-prefix convention) ────────────────────────
# The operator's secret store keeps this project's credentials under
# {{SERVICE_PREFIX_UPPER}}_-prefixed names so they are distinguishable from
# personal / other-service keys. Inside the container the tools expect the
# canonical names, so this file is where the remap happens: copy each
# {{SERVICE_PREFIX_UPPER}}_* value from the store into its canonical key below.
#
#   {{SERVICE_PREFIX_UPPER}}_ANTHROPIC_API_KEY  →  ANTHROPIC_API_KEY
#   {{SERVICE_PREFIX_UPPER}}_GH_TOKEN           →  GH_TOKEN
#   {{SERVICE_PREFIX_UPPER}}_DISCORD_BOT_TOKEN  →  DISCORD_BOT_TOKEN
#
# Using a dedicated token per service means a sandboxed agent cannot spend the
# operator's personal API budget or push with their personal GitHub identity.

# ─── GitHub credential ───────────────────────────────────────────────────────
# Repo URL and branch are hardcoded in compose.yml. Used for the first-boot
# clone of this repo (transiently — never persisted to .git/config) AND for the
# agent's ongoing git/gh/GitHub-API work, so it must stay set for the
# container's lifetime. Value of {{SERVICE_PREFIX_UPPER}}_GH_TOKEN.
GH_TOKEN=

# ─── Hermes runtime behavior ─────────────────────────────────────────────────
# gateway | cli | sleep   (default: sleep — keeps the container up for
# VS Code attach; switch to "gateway" once platform credentials are wired)
HERMES_MODE=sleep

# Comma-list of modules under .devcontainer/firewall.d/ to load, or "all" /
# "none". The kernel's universal _required/ and _optional/ sets (anthropic,
# github, npm, vscode, mise+pypi, telemetry) load regardless.
FIREWALL_MODULES=all

# Override the kernel default model config (anthropic / claude). Leave unset
# to keep the baked defaults.
HERMES_PROVIDER=
HERMES_MODEL=

# ─── Credentials (canonical names — see remap table above) ───────────────────
# Value of {{SERVICE_PREFIX_UPPER}}_ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# ─── Discord platform (set when HERMES_MODE=gateway) ─────────────────────────
# Delete this block, and .devcontainer/firewall.d/discord.conf, if this agent
# does not use Discord.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs (or usernames — resolved to IDs at
# startup) allowed to interact with the bot. The gateway fails closed:
# leaving this empty means no users are authorized.
DISCORD_ALLOWED_USERS=
