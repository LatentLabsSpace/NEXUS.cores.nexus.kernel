#!/usr/bin/env bash
# prepare-commit-msg — add `Claude-Session: <session id>` to commits made in a
# Claude Code session (CLAUDE_CODE_SESSION_ID set), so any commit leads back to
# the conversation that made it: `commit-session.sh <commit>` finds its
# transcript. An amend by another session adds that session as well; the same
# session never adds itself twice. Runs the repo's own hook first.
"$(dirname "$0")/_chain" prepare-commit-msg "$@" || exit $?
msg="$1"
[[ -n "${CLAUDE_CODE_SESSION_ID:-}" && -f "$msg" ]] || exit 0
[[ "$CLAUDE_CODE_SESSION_ID" =~ ^[A-Za-z0-9-]+$ ]] || exit 0
git interpret-trailers --in-place --if-exists addIfDifferent \
  --trailer "Claude-Session: $CLAUDE_CODE_SESSION_ID" "$msg" 2>/dev/null || true
exit 0
